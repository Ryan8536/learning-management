<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui.LMS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui.LMS"
    xmlns:views="clr-namespace:Maui.LMS.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Main Menu"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

    <ShellContent
        Title="Teacher Menu"
        Route="TeacherMenuPage"
        ContentTemplate="{DataTemplate views:TeacherMenuPage}" />

    <ShellContent
        Title="Student Menu"
        Route="StudentMenuPage"
        ContentTemplate="{DataTemplate views:StudentMenuPage}" />

    <ShellContent
        Title="Student Courses"
        Route="StudentCoursePage"
        ContentTemplate="{DataTemplate views:StudentCoursePage}" />

    <ShellContent
        Title="Student Course Details"
        Route="StudentCourseDetailPage"
        ContentTemplate="{DataTemplate views:StudentCourseDetailPage}" />

    <ShellContent
        Title="Course Details"
        Route="CourseDetailPage"
        ContentTemplate="{DataTemplate views:CourseDetailPage}" />

    <ShellContent
        Title="Course Menu"
        Route="CourseMenuPage"
        ContentTemplate="{DataTemplate views:CourseMenuPage}" />

</Shell>