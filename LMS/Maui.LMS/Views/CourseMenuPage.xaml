<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseMenuPage"
             Title="Course Menu"
             NavigatedTo="CourseMenuPageNavigatedTo">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
        RowSpacing="20">

        <Label
            Grid.Row="0"
            Text="Course Menu"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="{Binding Name}"
            FontSize="24"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="2"
            Text="{Binding Code}"
            HorizontalOptions="Center" />

        <CollectionView
            x:Name="ModulesCollectionView"
            Grid.Row="3">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <VerticalStackLayout Padding="10">

                        <Label
                            Text="{Binding Id,
                                   StringFormat='Module {0}'}"
                            FontSize="20" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="4"
            Text="Add Module"
            Clicked="AddModuleClicked" />

        <Button
            Grid.Row="5"
            Text="Back to Teacher Menu"
            Clicked="BackClicked" />

    </Grid>

</ContentPage>