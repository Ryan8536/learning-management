<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseMenuPage"
             Title="Course Menu"
             NavigatedTo="CourseMenuPageNavigatedTo">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Course Menu"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Name}"
                FontSize="24"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Code}"
                HorizontalOptions="Center" />

            <!-- Students -->

            <Label
                Text="Course Roster"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="RosterCollectionView"
                HeightRequest="160">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code,
                                       StringFormat='Student Code: {0}'}" />

                            <Label
                                Text="{Binding Classification,
                                       StringFormat='Classification: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Existing Students"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Select an existing student to enroll."
                FontSize="14" />

            <CollectionView
                x:Name="StudentsCollectionView"
                HeightRequest="160"
                SelectionMode="Single"
                SelectionChanged="StudentSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code,
                                       StringFormat='Student Code: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Enroll Selected Existing Student"
                Clicked="EnrollExistingStudentClicked" />

            <Label
                Text="Create and Enroll New Student"
                FontSize="24"
                Margin="0,20,0,0" />

            <Entry
                x:Name="StudentNameEntry"
                Placeholder="Student name" />

            <Entry
                x:Name="StudentCodeEntry"
                Placeholder="Student code" />

            <Entry
                x:Name="StudentClassificationEntry"
                Placeholder="Classification" />

            <Button
                Text="Create and Enroll Student"
                Clicked="CreateAndEnrollStudentClicked" />

            <!-- Modules -->

            <Label
                Text="Modules"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="ModulesCollectionView"
                HeightRequest="130"
                SelectionMode="Single"
                SelectionChanged="ModuleSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding Id,
                                   StringFormat='Module {0}'}"
                            Padding="10"
                            FontSize="20" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Add Module"
                Clicked="AddModuleClicked" />

            <Label
                Text="Selected Module Items"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="ContentCollectionView"
                HeightRequest="200"
                SelectionMode="Single"
                SelectionChanged="ContentSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding DisplayText}"
                            Padding="10"
                            FontSize="18" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry
                x:Name="ContentNameEntry"
                Placeholder="Page or file name" />

            <Editor
                x:Name="ContentDetailsEditor"
                Placeholder="Page text or file path"
                HeightRequest="90" />

            <Button
                Text="Add Page to Selected Module"
                Clicked="AddPageClicked" />

            <Button
                Text="Add File to Selected Module"
                Clicked="AddFileClicked" />

            <Label
                Text="Add Existing Assignment to Module"
                FontSize="18"
                Margin="0,10,0,0" />

            <Label
                Text="Select an assignment below."
                FontSize="14" />

            <CollectionView
                x:Name="ModuleAssignmentCollectionView"
                HeightRequest="150"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Add Selected Assignment to Module"
                Clicked="AddAssignmentToModuleClicked" />

            <Button
                Text="Update Selected Page or File"
                Clicked="UpdateContentClicked" />

            <Button
                Text="Remove Selected Module Item"
                Clicked="RemoveContentClicked" />

            <!-- Assignments -->

            <Label
                Text="Assignments"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Select an assignment to edit or delete it."
                FontSize="14" />

            <CollectionView
                x:Name="AssignmentsCollectionView"
                HeightRequest="220"
                SelectionMode="Single"
                SelectionChanged="AssignmentSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Description}" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                            <Label
                                Text="{Binding DueDate,
                                       StringFormat='Due: {0:MM/dd/yyyy}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Assignment Details"
                FontSize="24"
                Margin="0,20,0,0" />

            <Entry
                x:Name="AssignmentNameEntry"
                Placeholder="Assignment name" />

            <Editor
                x:Name="AssignmentDescriptionEditor"
                Placeholder="Assignment description"
                HeightRequest="90" />

            <Entry
                x:Name="AssignmentPointsEntry"
                Placeholder="Available points"
                Keyboard="Numeric" />

            <Label Text="Due Date" />

            <DatePicker
                x:Name="AssignmentDueDatePicker" />

            <Button
                Text="Add Assignment"
                Clicked="AddAssignmentClicked" />

            <Button
                Text="Update Selected Assignment"
                Clicked="UpdateAssignmentClicked" />

            <Button
                Text="Delete Selected Assignment"
                Clicked="DeleteAssignmentClicked" />

            <Button
                Text="Clear Assignment Form"
                Clicked="ClearAssignmentFormClicked" />

            <Button
                Text="Back to Teacher Menu"
                Clicked="BackClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>