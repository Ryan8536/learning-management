<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseMenuPage"
             Title="Course Menu"
             NavigatedTo="CourseMenuPageNavigatedTo">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Course Menu"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Name}"
                FontSize="24"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Code}"
                HorizontalOptions="Center" />


            <Button
               Text="Course Settings"
               Clicked="OpenCourseSettingsClicked" /> 
                  
            <!-- Announcements -->

            <Label
                Text="Announcements"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Create, update, or delete announcements for this course."
                FontSize="14" />

            <CollectionView
                x:Name="AnnouncementsCollectionView"
                HeightRequest="220"
                SelectionMode="Single"
                SelectionChanged="AnnouncementSelectionChanged">

                <CollectionView.EmptyView>
                    <Label Text="No announcements are available." FontSize="16" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10" Spacing="3">
                            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding Message}" />
                            <Label Text="{Binding PostedDate, StringFormat='Posted: {0:MM/dd/yyyy h:mm tt}'}" FontSize="13" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry x:Name="AnnouncementTitleEntry" Placeholder="Announcement title" />

            <Editor x:Name="AnnouncementMessageEditor" Placeholder="Announcement message" HeightRequest="110" />

            <Button Text="Add Announcement" Clicked="AddAnnouncementClicked" />

            <Button Text="Update Selected Announcement" Clicked="UpdateAnnouncementClicked" />

            <Button Text="Delete Selected Announcement" Clicked="DeleteAnnouncementClicked" />

            <Button Text="Clear Announcement Form" Clicked="ClearAnnouncementFormClicked" />

            <!-- Students -->

            <Label
                Text="Course Roster"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="RosterCollectionView"
                HeightRequest="160"
                SelectionMode="Single"
                SelectionChanged="RosterSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code,
                                       StringFormat='Student Code: {0}'}" />

                            <Label
                                Text="{Binding Classification,
                                       StringFormat='Classification: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Remove Selected Student from Course"
                Clicked="RemoveStudentFromRosterClicked" />

            <Label
                Text="Roster Import and Export"
                FontSize="20"
                Margin="0,15,0,0" />

            <Label
                Text="Export this roster as a CSV file or import students from a CSV file."
                FontSize="14" />

            <Button
                Text="Export Course Roster"
                Clicked="ExportRosterClicked" />

            <Button
                Text="Import Course Roster"
                Clicked="ImportRosterClicked" />

            <Label
                Text="Available University Students"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Select a university student to add to this course."
                FontSize="14" />

            <CollectionView
                x:Name="StudentsCollectionView"
                HeightRequest="160"
                SelectionMode="Single"
                SelectionChanged="StudentSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code,
                                       StringFormat='Student Code: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Enroll Selected Existing Student"
                Clicked="EnrollExistingStudentClicked" />

            <Label
                Text="Create and Enroll New Student"
                FontSize="24"
                Margin="0,20,0,0" />

            <Entry
                x:Name="StudentNameEntry"
                Placeholder="Student name" />

            <Entry
                x:Name="StudentCodeEntry"
                Placeholder="Student code" />

            <Entry
                x:Name="StudentClassificationEntry"
                Placeholder="Classification" />

            <Button
                Text="Create and Enroll Student"
                Clicked="CreateAndEnrollStudentClicked" />

            <!-- Modules -->

            <Label
                Text="Modules"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="ModulesCollectionView"
                HeightRequest="150"
                SelectionMode="Single"
                SelectionChanged="ModuleSelectionChanged">

                <CollectionView.EmptyView>
                    <Label
                        Text="No modules are available."
                        FontSize="16" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding DisplayText}"
                            Padding="10"
                            FontSize="20" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry
                x:Name="ModuleNameEntry"
                Placeholder="Module name" />

            <Button
                Text="Add Module"
                Clicked="AddModuleClicked" />

            <Button
                Text="Update Selected Module"
                Clicked="UpdateModuleClicked" />

            <Button
                Text="Delete Selected Module"
                Clicked="DeleteModuleClicked" />

            <Label
                Text="Selected Module Items"
                FontSize="24"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="ContentCollectionView"
                HeightRequest="200"
                SelectionMode="Single"
                SelectionChanged="ContentSelectionChanged">

                <CollectionView.EmptyView>
                    <Label
                        Text="The selected module has no content."
                        FontSize="16" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding DisplayText}"
                            Padding="10"
                            FontSize="18" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry
                x:Name="ContentNameEntry"
                Placeholder="Page or file name" />

            <Editor
                x:Name="ContentDetailsEditor"
                Placeholder="Page text or file path"
                HeightRequest="90" />

            <Button
                Text="Update Selected Page or File"
                Clicked="UpdateContentClicked" />

            <Button
                Text="Remove Selected Module Item"
                Clicked="RemoveContentClicked" />

            <Button
                Text="Add Page to Selected Module"
                Clicked="AddPageClicked" />

            <Button
                Text="Add File to Selected Module"
                Clicked="AddFileClicked" />

            <Label
                Text="Add Existing Assignment to Module"
                FontSize="18"
                Margin="0,10,0,0" />

            <Label
                Text="Select an assignment below."
                FontSize="14" />

            <CollectionView
                x:Name="ModuleAssignmentCollectionView"
                HeightRequest="150"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        Text="No assignments are available."
                        FontSize="16" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Add Selected Assignment to Module"
                Clicked="AddAssignmentToModuleClicked" />

            <!-- Assignments -->

            <Label
                Text="Assignments"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Select an assignment to edit or delete it."
                FontSize="14" />

            <CollectionView
                x:Name="AssignmentsCollectionView"
                HeightRequest="220"
                SelectionMode="Single"
                SelectionChanged="AssignmentSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Description}" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                            <Label
                                Text="{Binding DueDate,
                                       StringFormat='Due: {0:MM/dd/yyyy}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Assignment Details"
                FontSize="24"
                Margin="0,20,0,0" />

            <Entry
                x:Name="AssignmentNameEntry"
                Placeholder="Assignment name" />

            <Editor
                x:Name="AssignmentDescriptionEditor"
                Placeholder="Assignment description"
                HeightRequest="90" />

            <Entry
                x:Name="AssignmentPointsEntry"
                Placeholder="Available points"
                Keyboard="Numeric" />

            <Label Text="Due Date" />

            <DatePicker
                x:Name="AssignmentDueDatePicker" />

            <Button
                Text="Add Assignment"
                Clicked="AddAssignmentClicked" />

            <Button
                Text="Update Selected Assignment"
                Clicked="UpdateAssignmentClicked" />

            <Button
                Text="Delete Selected Assignment"
                Clicked="DeleteAssignmentClicked" />

            <Button
                Text="Clear Assignment Form"
                Clicked="ClearAssignmentFormClicked" />

            <Label
                Text="Import or Export Assignments"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Export this course's assignments to CSV or import assignments from a CSV file."
                FontSize="14" />

            <Button
                Text="Export Course Assignments"
                Clicked="ExportAssignmentsClicked" />
            
             <Button
                Text="Export Gradebook as CSV"
                Clicked="ExportGradebookClicked" />

            <Entry
                x:Name="AssignmentImportFileNameEntry"
                Placeholder="CSV filename in Downloads"
                Text="assignment-test.csv" />

            <Button
                Text="Import Course Assignments from Downloads"
                Clicked="ImportAssignmentsFromDownloadsClicked" />

            <Label
                Text="Copy Selected Assignment to Another Course"
                FontSize="24"
                Margin="0,20,0,0" />

            <Label
                Text="Select an assignment above, then select a destination course."
                FontSize="14" />

            <CollectionView
                x:Name="DestinationCoursesCollectionView"
                HeightRequest="180"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        Text="No other courses are available."
                        FontSize="16" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code}" />

                            <Label
                                Text="{Binding Semester,
                                       StringFormat='Semester: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Copy Selected Assignment"
                Clicked="CopyAssignmentClicked" />

            <!-- Assignment Groups -->

            <Label
                Text="Assignment Groups"
                FontSize="24"
                Margin="0,25,0,0" />

            <Label
                Text="Select a group to edit its name, weight, or assignments."
                FontSize="14" />

            <CollectionView
                x:Name="AssignmentGroupsCollectionView"
                HeightRequest="200"
                SelectionMode="Single"
                SelectionChanged="AssignmentGroupSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Weight,
                                       StringFormat='Weight: {0}%'}" />

                            <Label
                                Text="{Binding Assignments.Count,
                                       StringFormat='Assignments: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry
                x:Name="AssignmentGroupNameEntry"
                Placeholder="Assignment group name" />

            <Entry
                x:Name="AssignmentGroupWeightEntry"
                Placeholder="Assignment group weight (%)"
                Keyboard="Numeric" />

            <Button
                Text="Add Assignment Group"
                Clicked="AddAssignmentGroupClicked" />

            <Button
                Text="Update Selected Assignment Group"
                Clicked="UpdateAssignmentGroupClicked" />

            <Button
                Text="Delete Selected Assignment Group"
                Clicked="DeleteAssignmentGroupClicked" />

            <Label
                Text="Assignments in Selected Group"
                FontSize="20"
                Margin="0,15,0,0" />

            <CollectionView
                x:Name="GroupAssignmentsCollectionView"
                HeightRequest="180"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Remove Selected Assignment from Group"
                Clicked="RemoveAssignmentFromGroupClicked" />

            <Label
                Text="Add Assignment to Selected Group"
                FontSize="20"
                Margin="0,15,0,0" />

            <Label
                Text="Select an assignment below."
                FontSize="14" />

            <CollectionView
                x:Name="AvailableGroupAssignmentsCollectionView"
                HeightRequest="180"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Points: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Add Selected Assignment to Group"
                Clicked="AddAssignmentToGroupClicked" />

            <Button
                Text="Back to Teacher Menu"
                Clicked="BackClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>