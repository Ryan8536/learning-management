<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseMenuPage"
             Title="Course Menu"
             NavigatedTo="CourseMenuPageNavigatedTo">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,*,Auto,Auto,Auto,Auto"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Course Menu"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="1"
            Text="{Binding Name}"
            FontSize="24"
            HorizontalOptions="Center" />

        <Label
            Grid.Row="2"
            Text="{Binding Code}"
            HorizontalOptions="Center" />

        <CollectionView
            x:Name="ModulesCollectionView"
            Grid.Row="3"
            SelectionMode="Single"
            SelectionChanged="ModuleSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <VerticalStackLayout Padding="10">

                        <Label
                            Text="{Binding Id,
                                   StringFormat='Module {0}'}"
                            FontSize="20" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="4"
            Text="Add Module"
            Clicked="AddModuleClicked" />

        <Entry
            x:Name="ContentEntry"
            Grid.Row="5"
            Placeholder="Enter module content" />

        <CollectionView
            x:Name="ContentCollectionView"
            Grid.Row="6"
            SelectionMode="Single"
            SelectionChanged="ContentSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Label
                        Text="{Binding .}"
                        Padding="10"
                        FontSize="18" />

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="7"
            Text="Add Content to Selected Module"
            Clicked="AddContentClicked" />

        <Button
            Grid.Row="8"
            Text="Update Selected Content"
            Clicked="UpdateContentClicked" />

        <Button
            Grid.Row="9"
            Text="Remove Selected Content"
            Clicked="RemoveContentClicked" />

        <Button
            Grid.Row="10"
            Text="Back to Teacher Menu"
            Clicked="BackClicked" />

    </Grid>

</ContentPage>