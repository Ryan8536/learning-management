<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherMenuPage"
             Title="Teacher Menu"
             NavigatedTo="TeacherMenuPageNavigatedTo">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
        RowSpacing="20">

        <Label
            Grid.Row="0"
            Text="Teacher Menu"
            FontSize="32"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <Label
                Text="Filter Courses by Semester"
                FontSize="16" />

            <CollectionView
                x:Name="SemesterCollectionView"
                ItemsSource="{Binding SemesterOptions}"
                SelectedItem="{Binding SelectedSemester}"
                SelectionMode="Single"
                HeightRequest="150">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding .}"
                            Padding="10"
                            FontSize="17" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Courses}"
            SelectedItem="{Binding SelectedCourse}"
            SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <VerticalStackLayout
                        Padding="10"
                        Spacing="3">

                        <Label
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding Code}" />

                        <Label
                            Text="{Binding Semester,
                                   StringFormat='Semester: {0}'}" />

                        <Label
                            Text="{Binding Description}" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="3"
            Text="Add Course"
            Clicked="AddCourseClicked" />

        <Button
            Grid.Row="4"
            Text="Open Course"
            Clicked="OpenCourseClicked" />

        <Button
            Grid.Row="5"
            Text="Edit Course"
            Clicked="EditCourseClicked" />

        <Button
            Grid.Row="6"
            Text="Copy Selected Course"
            Clicked="CopyCourseClicked" />

        <Button
            Grid.Row="7"
            Text="Delete Course"
            Clicked="DeleteCourseClicked" />

        <Button
            Grid.Row="8"
            Text="Return to Main Menu"
            Clicked="ReturnToMainMenuClicked" />

    </Grid>

</ContentPage>