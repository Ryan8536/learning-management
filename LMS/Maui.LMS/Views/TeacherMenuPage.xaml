<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherMenuPage"
             Title="Teacher Menu"
             NavigatedTo="TeacherMenuPageNavigatedTo">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Teacher Menu"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="Courses"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="Filter Courses by Semester"
                FontSize="16" />

            <CollectionView
                x:Name="SemesterCollectionView"
                ItemsSource="{Binding SemesterOptions}"
                SelectedItem="{Binding SelectedSemester}"
                SelectionMode="Single"
                HeightRequest="150">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding .}"
                            Padding="10"
                            FontSize="17" />

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <CollectionView
                ItemsSource="{Binding Courses}"
                SelectedItem="{Binding SelectedCourse}"
                SelectionMode="Single"
                HeightRequest="300">

                <CollectionView.EmptyView>

                    <Label
                        Text="No courses are available."
                        FontSize="17"
                        HorizontalOptions="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code}" />

                            <Label
                                Text="{Binding Semester,
                                       StringFormat='Semester: {0}'}" />

                            <Label
                                Text="{Binding Description}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Add Course"
                    Clicked="AddCourseClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="Open Course"
                    Clicked="OpenCourseClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Edit Course"
                    Clicked="EditCourseClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="Copy Selected Course"
                    Clicked="CopyCourseClicked" />

                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="Delete Course"
                    Clicked="DeleteCourseClicked" />

            </Grid>

            <BoxView
                HeightRequest="1" />

            <Label
                Text="Semester Date Management"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="Create and manage semester start and stop dates."
                FontSize="16" />

            <Entry
                x:Name="SemesterNameEntry"
                Placeholder="Semester name, such as Fall 2026" />

            <Label
                Text="Start Date"
                FontSize="16" />

            <DatePicker
                x:Name="SemesterStartDatePicker" />

            <Label
                Text="Stop Date"
                FontSize="16" />

            <DatePicker
                x:Name="SemesterEndDatePicker" />

            <CollectionView
                x:Name="ManagedSemestersCollectionView"
                HeightRequest="250"
                SelectionMode="Single"
                SelectionChanged="ManagedSemesterSelectionChanged">

                <CollectionView.EmptyView>

                    <Label
                        Text="No semester date ranges are available."
                        FontSize="17"
                        HorizontalOptions="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding StartDate,
                                       StringFormat='Start: {0:MM/dd/yyyy}'}" />

                            <Label
                                Text="{Binding EndDate,
                                       StringFormat='Stop: {0:MM/dd/yyyy}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Add Semester"
                    Clicked="AddSemesterClicked" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="Update Semester"
                    Clicked="UpdateSemesterClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Delete Semester"
                    Clicked="DeleteSemesterClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="Clear Semester Form"
                    Clicked="ClearSemesterFormClicked" />

            </Grid>

            <BoxView
                HeightRequest="1" />

            <Label
                Text="University Students"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="Add, edit, or remove students from the university."
                FontSize="16" />

            <CollectionView
                x:Name="StudentsCollectionView"
                HeightRequest="300"
                SelectionMode="Single"
                SelectionChanged="StudentSelectionChanged">

                <CollectionView.EmptyView>

                    <Label
                        Text="No university students are available."
                        FontSize="17"
                        HorizontalOptions="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Code,
                                       StringFormat='Student Code: {0}'}" />

                            <Label
                                Text="{Binding Classification,
                                       StringFormat='Classification: {0}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Add Student"
                    Clicked="AddStudentClicked" />

                <Button
                    Grid.Column="1"
                    Text="Edit Student"
                    Clicked="EditStudentClicked" />

                <Button
                    Grid.Column="2"
                    Text="Delete Student"
                    Clicked="DeleteStudentClicked" />

            </Grid>

            <Button
                Text="Return to Main Menu"
                Clicked="ReturnToMainMenuClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
