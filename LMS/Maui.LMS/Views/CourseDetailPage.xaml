<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseDetailPage"
             Title="Course Details"
             NavigatedTo="CourseDetailPageNavigatedTo">

    <VerticalStackLayout
        Padding="30"
        Spacing="15">

        <Label
            Text="Course Details"
            FontSize="32"
            HorizontalOptions="Center" />

        <Entry
            x:Name="NameEntry"
            Placeholder="Course Name" />

        <Entry
            x:Name="CodeEntry"
            Placeholder="Course Code" />

        <Entry
            x:Name="SemesterEntry"
            Placeholder="Semester, such as Fall 2026" />

        <Editor
            x:Name="DescriptionEditor"
            Placeholder="Course Description"
            HeightRequest="120" />

        <Button
            Text="Save Course"
            Clicked="SaveCourseClicked" />

        <Button
            Text="Cancel"
            Clicked="CancelClicked" />

    </VerticalStackLayout>

</ContentPage>