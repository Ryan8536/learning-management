<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.CourseDetailPage"
             Title="Add Course"
             NavigatedTo="CourseDetailPageNavigatedTo">

    <VerticalStackLayout
        Padding="30"
        Spacing="15">

        <Label
            Text="Add Course"
            FontSize="32"
            HorizontalOptions="Center" />

        <Entry
            Placeholder="Course Name"
            Text="{Binding Name}" />

        <Entry
            Placeholder="Course Code"
            Text="{Binding Code}" />

        <Editor
            Placeholder="Course Description"
            Text="{Binding Description}"
            HeightRequest="120" />

        <Button
            Text="Save Course"
            Clicked="SaveCourseClicked" />

        <Button
            Text="Cancel"
            Clicked="CancelClicked" />

    </VerticalStackLayout>

</ContentPage>