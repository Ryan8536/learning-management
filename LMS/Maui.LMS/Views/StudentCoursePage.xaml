<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.StudentCoursePage"
             Title="Student Courses"
             NavigatedTo="StudentCoursePageNavigatedTo">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="Student Courses"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label
            x:Name="StudentNameLabel"
            FontSize="24"
            HorizontalOptions="Center" />

        <Label
            Text="The enrolled course list will appear here."
            FontSize="16"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>