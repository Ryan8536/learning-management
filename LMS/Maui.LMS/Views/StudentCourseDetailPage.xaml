<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.StudentCourseDetailPage"
             Title="Course Details"
             NavigatedTo="StudentCourseDetailPageNavigatedTo">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="18">

            <Label
                Text="Course Details"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                x:Name="StudentNameLabel"
                FontSize="18"
                HorizontalOptions="Center" />

            <Label
                x:Name="CourseNameLabel"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="CourseCodeLabel"
                FontSize="17"
                HorizontalOptions="Center" />

            <Label
                x:Name="SemesterLabel"
                FontSize="17"
                HorizontalOptions="Center" />

            <Label
                x:Name="SectionLabel"
                FontSize="17"
                HorizontalOptions="Center" />

            <Label
                x:Name="DescriptionLabel"
                FontSize="17" />

            <!-- Announcements -->

            <Border
                Padding="18"
                StrokeThickness="2">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Course Announcements"
                        FontSize="24"
                        FontAttributes="Bold" />

                    <CollectionView
                        x:Name="AnnouncementsCollectionView"
                        HeightRequest="220"
                        SelectionMode="None">

                        <CollectionView.EmptyView>

                            <Label
                                Text="There are no course announcements."
                                FontSize="16" />

                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="12"
                                    Margin="0,4"
                                    StrokeThickness="1">

                                    <VerticalStackLayout
                                        Spacing="5">

                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="19"
                                            FontAttributes="Bold" />

                                        <Label
                                            Text="{Binding Message}"
                                            FontSize="16" />

                                        <Label
                                            Text="{Binding PostedDate,
                                                   StringFormat='Posted: {0:MM/dd/yyyy h:mm tt}'}"
                                            FontSize="13"
                                            FontAttributes="Italic" />

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Border>

            <!-- Current Grade -->

            <Border
                Padding="20"
                StrokeThickness="2">

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="Current Course Grade"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="LetterGradeLabel"
                        Text="Not Available"
                        FontSize="42"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="CoursePercentageLabel"
                        Text="No graded submissions"
                        FontSize="20"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Border>

            <BoxView
                HeightRequest="1" />

            <!-- Assignments -->

            <Label
                Text="Assignments"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Select an assignment to submit a response."
                FontSize="16" />

            <CollectionView
                x:Name="AssignmentsCollectionView"
                HeightRequest="220"
                SelectionMode="Single"
                SelectionChanged="AssignmentSelectionChanged">

                <CollectionView.EmptyView>

                    <Label
                        Text="No assignments are available."
                        FontSize="16" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="3">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Description}" />

                            <Label
                                Text="{Binding AvailablePoints,
                                       StringFormat='Available Points: {0}'}" />

                            <Label
                                Text="{Binding DueDate,
                                       StringFormat='Due: {0:MM/dd/yyyy}'}" />

                        </VerticalStackLayout>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                x:Name="SelectedAssignmentLabel"
                Text="No assignment selected"
                FontSize="18"
                FontAttributes="Bold" />

            <Editor
                x:Name="ResponseEditor"
                Placeholder="Enter your assignment response here..."
                HeightRequest="150"
                AutoSize="TextChanges" />

            <Button
                Text="Submit Response"
                Clicked="SubmitResponseClicked" />

            <Label
                x:Name="SubmissionStatusLabel"
                FontSize="16" />

            <BoxView
                HeightRequest="1" />

            <!-- Modules -->

            <Label
                Text="Modules and Content"
                FontSize="24"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="ModuleContentCollectionView"
                HeightRequest="250"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <Label
                        Text="No module content is available."
                        FontSize="16" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Label
                            Text="{Binding .}"
                            Padding="10"
                            FontSize="17" />

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <BoxView
                HeightRequest="1" />

            <!-- Grades -->

            <Label
                Text="Grades"
                FontSize="24"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="GradesCollectionView"
                HeightRequest="220"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <Label
                        Text="No graded submissions are available."
                        FontSize="16" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Label
                            Text="{Binding .}"
                            Padding="10"
                            FontSize="17" />

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Return to Course List"
                Clicked="ReturnToCourseListClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>