<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.MainPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Learning Management System"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="Select how you would like to use the application"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                Text="Teacher"
                FontSize="20"
                HeightRequest="60"
                Clicked="TeacherClicked" />

            <Button
                Text="Student"
                FontSize="20"
                HeightRequest="60"
                Clicked="StudentClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>